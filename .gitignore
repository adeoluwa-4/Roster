# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/warehouse/target/
/warehouse/logs/
/warehouse/*.duckdb
/warehouse/*.duckdb.wal
/.venv/
__pycache__/
*.py[cod]

# These exports are reproducible pipeline products and remain versioned because
# the public game imports them during a clean build.
!/data/players.json
!/data/puzzles.json
